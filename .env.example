# PostgreSQL local: estos valores deben coincidir con DATABASE_URL.
DB_USER=arcangel
DB_PASSWORD=change-me-local
DB_NAME=el_arcangel
DATABASE_URL=postgresql://arcangel:change-me-local@localhost:5433/el_arcangel?schema=public

# Elegí una contraseña antes de habilitar el administrador.
ADMIN_PASSWORD=
# Opcional: secreto independiente para firmar sesiones.
ADMIN_SESSION_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=el-arcangel

# URL pública real, con https://. Configurar también en Vercel.
SITE_URL=
